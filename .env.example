# ---------------------------------------------------------------------------
# EstateIQ environment configuration (copy to `.env` and adjust)
# ---------------------------------------------------------------------------

# Database (PostgreSQL). In production point this at your managed Postgres.
# Locally you can use the embedded dev database: `npm run db:start`.
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/estateiq?schema=public"

# Local embedded dev/test database (only used by scripts/dev-db.ts)
DEV_DATABASE_PORT="5433"
DEV_DATABASE_DIR=".pgdata"
DEV_DATABASE_NAME="estateiq"
TEST_DATABASE_NAME="estateiq_test"

# Auth.js
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"
SESSION_MAX_AGE_SECONDS="28800"

# AI provider abstraction: mock | openai | anthropic | gemini
# `mock` runs the deterministic local provider: fully functional, no API key needed.
AI_PROVIDER="mock"
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional seed overrides
SEED_DEFAULT_PASSWORD="Password123!"

# Platform (super) admin bootstrap, created by the seeder
PLATFORM_ADMIN_EMAIL="platform@estateiq.dev"

# Production: first organization + owner, created by `npm run db:bootstrap`
# (also run by `vercel-build`). Leave BOOTSTRAP_OWNER_EMAIL empty to skip.
# The password is only used when the user does not exist yet.
BOOTSTRAP_ORG_NAME=""
BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""
BOOTSTRAP_OWNER_NAME=""
