# ---------------------------------------------------------------------------
# EstateIQ environment configuration (copy to `.env` and adjust)
# ---------------------------------------------------------------------------

# Database (MySQL or MariaDB): mysql://user:password@host:3306/database
# URL-encode special characters in the password (e.g. @ -> %40).
# In production point this at your host's database (Hostinger: host "localhost").
# Locally you can use the portable dev database: `npm run db:start`.
DATABASE_URL="mysql://root:password@127.0.0.1:3307/estateiq"

# Local dev/test MariaDB server (only used by scripts/dev-db.ts)
DEV_DATABASE_PORT="3307"
DEV_DATABASE_DIR=".dbdata"
# DEV_MARIADB_HOME=""   # existing MariaDB install; on Windows it is downloaded if unset
DEV_DATABASE_NAME="estateiq"
TEST_DATABASE_NAME="estateiq_test"

# Auth.js
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:3000"
SESSION_MAX_AGE_SECONDS="28800"

# AI provider abstraction: mock | openai | anthropic | gemini
# `mock` runs the deterministic local provider: fully functional, no API key needed.
AI_PROVIDER="mock"
AI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional seed overrides
SEED_DEFAULT_PASSWORD="Password123!"

# Platform (super) admin bootstrap, created by the seeder
PLATFORM_ADMIN_EMAIL="platform@estateiq.dev"

# Production: first organization + owner, created by `npm run db:bootstrap`.
# Leave BOOTSTRAP_OWNER_EMAIL empty to skip.
# The password is only used when the user does not exist yet.
BOOTSTRAP_ORG_NAME=""
BOOTSTRAP_OWNER_EMAIL=""
BOOTSTRAP_OWNER_PASSWORD=""
BOOTSTRAP_OWNER_NAME=""
